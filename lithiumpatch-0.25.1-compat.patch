+// ---------- 版本容錯輔助（本輪為讓 patch 同時適用於 Lithium 0.25.0 / 0.25.1 而加）----------
+//
+// 上游小版本重新編譯後，smali 會產生兩種「非語意」的漂移：
+//   1. `.line NN` 行號整體位移（0.25.0 → 0.25.1 幾乎每個檔案都有）；
+//   2. 暫存器配置改變（v0/v2/v5 之類）與匿名內部類別編號改變（ReaderActivity$7 → $8）、
+//      合成取用器編號改變（access$1000 → access$1100）。
+// 原本 patch 全部用逐字比對，於是 1 就讓 31 個 patch 中的 7 個失效。
+// 下面的 helper 只放寬「比對」，不放寬「取代內容」，因此不會無聲地貼錯程式碼。
+
+var smaliLineRe = regexp.MustCompile(`\\\.line [0-9]+`)
+
+// smaliPattern 把一段 smali 文字轉成正規表達式：其中的 `.line NN` 可對應任意行號，
+// 其餘字元全部原樣比對（暫存器名稱仍然要求一致，避免匹配到錯誤位置）。
+func smaliPattern(literal string) (*regexp.Regexp, error) {
+	return regexp.Compile(smaliLineRe.ReplaceAllString(regexp.QuoteMeta(literal), `\.line [0-9]+`))
+}
+
+// MustContainSmali 只確認 smali 區塊存在（忽略 `.line` 行號），不做任何修改。
+func MustContainSmali(find string) StringPatcher {
+	return StringPatcherFunc(func(x string) (string, error) {
+		re, err := smaliPattern(find)
+		if err != nil {
+			return x, fmt.Errorf("invalid smali pattern: %w", err)
+		}
+		if !re.MatchString(x) {
+			return x, fmt.Errorf("could not find smali block (ignoring .line numbers):\n%s", find)
+		}
+		return x + "\n", nil // 與 MustContain 相同的 hack，讓它可以用在 InMethod 裡
+	})
+}
+
+// ReplaceStringSmali 以「忽略 `.line` 行號」的方式比對 find，並把比對到的整段換成 replace
+// （等同 ReplaceString 的語意；原本的 `.line` 會一併被換掉，不影響執行）。
+func ReplaceStringSmali(find, replace string) StringPatcher {
+	return StringPatcherFunc(func(x string) (string, error) {
+		re, err := smaliPattern(find)
+		if err != nil {
+			return x, fmt.Errorf("invalid smali pattern: %w", err)
+		}
+		out := spliceAll(re, x, func(string) string { return replace })
+		if out == x {
+			return x, fmt.Errorf("could not find smali block (ignoring .line numbers):\n%s", find)
+		}
+		return out, nil
+	})
+}
+
+// ReplaceStringPrependSmali 同 ReplaceStringSmali，但保留比對到的原文、把 replace 加在它前面。
+func ReplaceStringPrependSmali(find, replace string) StringPatcher {
+	return StringPatcherFunc(func(x string) (string, error) {
+		re, err := smaliPattern(find)
+		if err != nil {
+			return x, fmt.Errorf("invalid smali pattern: %w", err)
+		}
+		out := spliceAll(re, x, func(m string) string { return replace + m })
+		if out == x {
+			return x, fmt.Errorf("could not find smali block (ignoring .line numbers):\n%s", find)
+		}
+		return out, nil
+	})
+}
+
+// ReplaceStringAppendSmali 同 ReplaceStringPrependSmali，但加在比對到的原文後面。
+func ReplaceStringAppendSmali(find, replace string) StringPatcher {
+	return StringPatcherFunc(func(x string) (string, error) {
+		re, err := smaliPattern(find)
+		if err != nil {
+			return x, fmt.Errorf("invalid smali pattern: %w", err)
+		}
+		out := spliceAll(re, x, func(m string) string { return m + replace })
+		if out == x {
+			return x, fmt.Errorf("could not find smali block (ignoring .line numbers):\n%s", find)
+		}
+		return out, nil
+	})
+}
+
+// spliceAll 把 re 在 s 中的每個匹配交辦給 f 產生取代文字（手動拼接，
+// 不用 ReplaceAllString，避免 smali 內容中的 `$id`、`$ScrollingViewBehavior` 等
+// 被當成正規表達式群組參照而吃掉字元）。
+func spliceAll(re *regexp.Regexp, s string, f func(match string) string) string {
+	var b strings.Builder
+	last := 0
+	for _, loc := range re.FindAllStringIndex(s, -1) {
+		b.WriteString(s[last:loc[0]])
+		b.WriteString(f(s[loc[0]:loc[1]]))
+		last = loc[1]
+	}
+	b.WriteString(s[last:])
+	return b.String()
+}
+
+// MustContainRe 用正規表達式確認內容存在（用來比對「暫存器名稱會漂」的指令行）。
+func MustContainRe(find *regexp.Regexp) StringPatcher {
+	return StringPatcherFunc(func(x string) (string, error) {
+		if !find.MatchString(x) {
+			return x, fmt.Errorf("could not match %q", find.String())
+		}
+		return x + "\n", nil
+	})
+}
+
+// ReplaceStringRePrepend 用正規表達式比對，保留「實際匹配到的原文」，
+// 並在它前面插入 tmpl 展開後的文字；tmpl 中的 $1、$2 是正規表達式的捕获群。
+//
+// 為什麼需要它：d8 編譯器在不同版本之間會把同一段 Java 程式碼配置到不同的暫存器
+// （例：Lithium 0.25.0 用 v3/v5，0.25.1 改成 v2/v4）。把暫存器名字寫死的 patch
+// 升版就會失配；用捕获群把暫存器名字「抄過來」，插入的程式碼才會跟著對上。
+func ReplaceStringRePrepend(re *regexp.Regexp, tmpl string) StringPatcher {
+	return StringPatcherFunc(func(x string) (string, error) {
+		idx := re.FindAllStringSubmatchIndex(x, -1)
+		if len(idx) == 0 {
+			return x, fmt.Errorf("could not match %q", re.String())
+		}
+		var b strings.Builder
+		last := 0
+		for _, m := range idx {
+			b.WriteString(x[last:m[0]])
+			b.WriteString(string(re.ExpandString(nil, tmpl, x, m)))
+			b.WriteString(x[m[0]:m[1]])
+			last = m[1]
+		}
+		b.WriteString(x[last:])
+		return b.String(), nil
+	})
+}
+
+// InnerClass 記載「動態找到的匿名內部類別」。
+type InnerClass struct {
+	Path  string // 解包目錄下的相對路徑，例 smali/com/faultexception/reader/ReaderActivity$8.smali
+	Class string // 類別描述符，例 Lcom/faultexception/reader/ReaderActivity$8;
+	Data  string // 該檔案內容
+}
+
+// Accessor 從找到的類別內容中，解析出外層類別的合成取用器名稱
+// （例：`access$1100`），簽名形如 L<outer>;->access$N(L<outer>;)L<returnDesc>;。
+// 上游小版本會讓這個編號漂移，所以一律動態解析、不寫死。
+func (i *InnerClass) Accessor(outer, returnDesc string) (string, error) {
+	re := regexp.MustCompile(`L` + regexp.QuoteMeta(outer) + `;->(access\$\d+)\(L` + regexp.QuoteMeta(outer) + `;\)L` + regexp.QuoteMeta(returnDesc) + `;`)
+	m := re.FindStringSubmatch(i.Data)
+	if m == nil {
+		return "", fmt.Errorf("no synthetic accessor for %q returning %q in %s", outer, returnDesc, i.Path)
+	}
+	return m[1], nil
+}
+
+type innerClassInst struct {
+	Outer  string // 例 com/faultexception/reader/ReaderActivity
+	Method string // 例 onTextAlignChanged(I)V
+	Make   func(*InnerClass) []StringPatcher
+}
+
+// PatchInnerClass 在外層類別的匿名內部類別中，找出「實作了 method 的那一顆」再套用 patcher。
+// 因為上游小版本會讓 $7/$8 這種編號漂移，寫死路徑的 patch 會在升版後整段失效。
+func PatchInnerClass(outer, method string, mk func(*InnerClass) []StringPatcher) Instruction {
+	return &innerClassInst{outer, method, mk}
+}
+
+func (i *innerClassInst) Do(apk string, diffwriter io.Writer) error {
+	methodRe := regexp.MustCompile(`(?m)^\.method [^\n]*` + regexp.QuoteMeta(i.Method))
+
+	var found []*InnerClass
+	subs, err := filepath.Glob(filepath.Join(apk, "smali*"))
+	if err != nil {
+		return err
+	}
+	for _, sub := range subs {
+		st, err := os.Stat(sub)
+		if err != nil || !st.IsDir() {
+			continue
+		}
+		// apktool 可能解出 smali/ 與 smali_classes2/，兩邊都要找
+		root := filepath.ToSlash(strings.TrimPrefix(sub, apk+string(os.PathSeparator)))
+		matches, err := filepath.Glob(filepath.Join(sub, filepath.FromSlash(i.Outer)+"$*.smali"))
+		if err != nil {
+			return err
+		}
+		for _, m := range matches {
+			// 只接受解包目錄底下的檔案，避免路徑跑到目錄外
+			clean := filepath.Clean(m)
+			if !strings.HasPrefix(clean, filepath.Clean(sub)+string(os.PathSeparator)) {
+				continue
+			}
+			data, err := os.ReadFile(clean)
+			if err != nil {
+				return err
+			}
+			s := strings.ReplaceAll(string(data), "\r\n", "\n")
+			if !methodRe.MatchString(s) {
+				continue
+			}
+			relPath := filepath.ToSlash(strings.TrimPrefix(clean, apk+string(os.PathSeparator)))
+			cls := "L" + strings.TrimSuffix(strings.TrimPrefix(relPath, root+"/"), ".smali") + ";"
+			found = append(found, &InnerClass{Path: relPath, Class: cls, Data: s})
+		}
+	}
+	if len(found) == 0 {
+		return fmt.Errorf("no inner class of %s implementing %q found", i.Outer, i.Method)
+	}
+	if len(found) > 1 {
+		var names []string
+		for _, f := range found {
+			names = append(names, f.Class)
+		}
+		return fmt.Errorf("ambiguous inner classes implementing %q: %s", i.Method, strings.Join(names, ", "))
+	}
+	ic := found[0]
+	return PatchFile(ic.Path, i.Make(ic)...).Do(apk, diffwriter)
+}
